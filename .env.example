# Copia a .env para sobrescribir valores. Todos son opcionales.

# MediaMTX corre en el mismo Mac -> loopback; no depende de la IP del router.
RTSP_URL=rtsp://127.0.0.1:8554/drone

MODEL_PATH=models/yolo11n.pt
CONFIDENCE_THRESHOLD=0.35
INFERENCE_IMGSZ=640
# Tamaño máximo (lado largo) del frame que se mantiene para visualizar; 0 = sin límite
DEVICE=cpu

# Reconexión RTSP
RECONNECT_DELAY_S=1.0
RECONNECT_MAX_DELAY_S=10.0
# Segundos sin frames nuevos antes de considerar el stream caído
STALL_TIMEOUT_S=5.0

# Tracking: segundos que se recuerda a una persona tras perderla de vista
TRACKING_TIMEOUT_S=3.0
# FPS de procesamiento aproximados (convierte el timeout a frames del tracker)
PROCESS_FPS_ESTIMATE=10

# PPE: modelo entrenado (scripts/train_ppe.py). Umbral bajo a propósito: la lógica de
# src/safety/ppe.py aplica sus propios umbrales y filtro temporal.
PPE_MODEL_PATH=models/runs/ppe-v1/weights/best.pt
PPE_CONFIDENCE=0.25
PPE_IMGSZ=512

# Reglas de incidencia
# Segundos continuos sin EPI antes de crear incidencia (evidencia explícita)
VIOLATION_DURATION_S=5.0
# Casco sin evidencia explícita (solo se ve que falta): exige más tiempo
HELMET_INFERRED_DURATION_S=8.0
# El chaleco no tiene clase "no_vest": solo se infiere por ausencia, así que exige más tiempo
VEST_INFERRED_DURATION_S=10.0
# No repetir incidencia del mismo tipo para la misma persona durante este tiempo
INCIDENT_COOLDOWN_S=60.0
# true: sin casco solo si el modelo detecta "no_helmet" (más estricto, pero esa clase tiene poco recall)
REQUIRE_EXPLICIT_HELMET=false
# Los snapshots más antiguos se borran al arrancar (privacidad / minimizar almacenamiento)
SNAPSHOT_RETENTION_DAYS=30

SHOW_WINDOW=true
